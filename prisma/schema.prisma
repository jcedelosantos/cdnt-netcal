generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "sqlite"
    url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String
  role          String    @default("user")
  emailVerified DateTime?
  image         String?
  empresaNombre    String?
  empresaRNC       String?
  empresaTelefono  String?
  empresaDireccion String?
  empresaEmail     String?
  empresaLogo      String?  // data URL (base64) del logo
  empresaBanco         String?
  empresaCuenta        String?
  empresaTipoCuenta    String?
  empresaNombreCuenta  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  projects      Project[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id                  String   @id @default(cuid())
  userId              String
  nombre              String
  cliente             String?
  ubicacion           String?
  fecha               DateTime @default(now())
  aprobado            Boolean  @default(false)
  aprobadoEn          DateTime?
  numeroCotizacion    String?
  numeroFactura       String?
  facturadoEn         DateTime?
  estadoPago          String   @default("pendiente")
  moneda              String   @default("DOP")
  modoAvanzado        Boolean  @default(false)
  tipoInstalacion     String   @default("expuesta")
  tipoCanalización    String   @default("EMT")
  categoriaCable      String   @default("Cat6")
  distanciaPromedio   Float    @default(30)
  reservaCable        Float    @default(15)
  reservaMateriales   Float    @default(10)
  switchPuertos       Int      @default(24)
  switchPoE           Boolean  @default(false)
  switchPuertosPoE    Int      @default(0)
  gabineteRU          Int      @default(12)
  incluyeUPS          Boolean  @default(false)
  incluyeCotizacion   Boolean  @default(false)
  margenGanancia      Float    @default(0)
  costoManoObra       Float    @default(0)
  costoTransporte     Float    @default(0)
  costoConfiguracion  Float    @default(0)
  costoCertificacion  Float    @default(0)
  itbis               Float    @default(18)
  notas               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  puntos              ProjectPoint[]
  materiales          ProjectMaterial[]
  pagos               Pago[]

  @@index([userId])
}

model ProjectPoint {
  id            String  @id @default(cuid())
  projectId     String
  tipo          String
  cantidad      Int     @default(1)
  distancia     Float   @default(30)
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Pago {
  id          String   @id @default(cuid())
  projectId   String
  concepto    String   @default("Pago")
  monto       Float
  fecha       DateTime @default(now())
  metodoPago  String?
  referencia  String?
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectMaterial {
  id              String  @id @default(cuid())
  projectId       String
  categoria       String
  nombre          String
  cantidad        Float   @default(0)
  unidad          String  @default("und")
  precioUnit      Float   @default(0)
  subtotal        Float   @default(0)
  esPersonalizado Boolean @default(false)
  project         Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}
