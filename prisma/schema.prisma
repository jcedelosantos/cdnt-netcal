generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String
  role          String    @default("user")
  emailVerified DateTime?
  image         String?
  empresaNombre    String?
  empresaRNC       String?
  empresaTelefono  String?
  empresaDireccion String?
  empresaEmail     String?
  empresaLogo      String?  // data URL (base64) del logo
  empresaBanco         String?
  empresaCuenta        String?
  empresaTipoCuenta    String?
  empresaNombreCuenta  String?
  validezCotizacion    Int      @default(30)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  projects      Project[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id                  String   @id @default(cuid())
  userId              String
  nombre              String
  cliente             String?
  clienteRNC          String?
  ubicacion           String?
  fecha               DateTime @default(now())
  aprobado            Boolean  @default(false)
  aprobadoEn          DateTime?
  numeroCotizacion    String?
  numeroFactura       String?
  facturadoEn         DateTime?
  estadoPago          String   @default("pendiente")
  moneda              String   @default("DOP")
  modoAvanzado        Boolean  @default(false)
  tipoInstalacion     String   @default("expuesta")
  tipoCanalización    String   @default("EMT")
  categoriaCable      String   @default("Cat6")
  distanciaPromedio   Float    @default(30)
  reservaCable        Float    @default(15)
  reservaMateriales   Float    @default(10)
  switchPuertos       Int      @default(24)
  switchPoE           Boolean  @default(false)
  switchPuertosPoE    Int      @default(0)
  gabineteRU          Int      @default(12)
  incluyeUPS          Boolean  @default(false)
  incluyeCotizacion   Boolean  @default(false)
  margenGanancia      Float    @default(0)
  costoManoObra       Float    @default(0)
  costoTransporte     Float    @default(0)
  costoConfiguracion  Float    @default(0)
  costoCertificacion  Float    @default(0)
  itbis               Float    @default(18)
  notas               String?
  inventoryClientId   String?  // Link a cliente de inventario
  inventoryClient     InventoryClient? @relation(fields: [inventoryClientId], references: [id], onDelete: SetNull)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  puntos              ProjectPoint[]
  materiales          ProjectMaterial[]
  pagos               Pago[]
  asignaciones        ProyectoAsignacion[]
  jornadas            Jornada[]

  @@index([userId])
  @@index([inventoryClientId])
}

model ProjectPoint {
  id            String  @id @default(cuid())
  projectId     String
  tipo          String
  cantidad      Int     @default(1)
  distancia     Float   @default(30)
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Pago {
  id          String   @id @default(cuid())
  projectId   String
  concepto    String   @default("Pago")
  monto       Float
  fecha       DateTime @default(now())
  metodoPago  String?
  referencia  String?
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectMaterial {
  id              String  @id @default(cuid())
  projectId       String
  categoria       String
  nombre          String
  cantidad        Float   @default(0)
  unidad          String  @default("und")
  precioUnit      Float   @default(0)
  subtotal        Float   @default(0)
  esPersonalizado Boolean @default(false)
  project         Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// ============================================
// MÓDULO INVENTARIO (inventory-tic integration)
// ============================================

model InventoryClient {
  id            String   @id @default(cuid())
  userId        String
  nombre        String
  contacto      String?
  telefono      String?
  email         String?
  direccion     String?
  notas         String?
  activo        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  equipment        InventoryEquipment[]
  licenses         InventoryLicense[]
  consumptions     InventoryMonthlyConsumption[]
  supports         InventoryThirdPartySupport[]
  projects         InventoryITProject[]
  redcalcProjects  Project[]  // Link bidireccional con proyectos de RedCalc
  ticInventarios   TicInventario[]  // Inventarios TIC con categorías y artículos

  @@index([userId])
}

model InventoryEquipment {
  id            String   @id @default(cuid())
  nombre        String
  direccionIp   String?
  fabricante    String?
  direccionMac  String?
  comentarios   String?
  tipoEquipo    String?  @default("otro")
  numeroSerie   String?
  fechaCompra   DateTime?
  garantia      DateTime?
  estado        String   @default("activo")
  responsable   String?
  costoUsd      Float?   @default(0)
  clientId      String?
  client        InventoryClient?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([estado])
  @@index([tipoEquipo])
  @@index([clientId])
}

model InventoryLicense {
  id                String   @id @default(cuid())
  nombre            String
  categoria         String?
  proveedor         String?
  fechaInicio       DateTime?
  fechaVencimiento  DateTime?
  costoAnual        Float    @default(0)
  responsable       String?
  estado            String   @default("activa")
  notas             String?
  clientId          String?
  client            InventoryClient?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([estado])
  @@index([clientId])
}

model InventoryMonthlyConsumption {
  id            String   @id @default(cuid())
  nombre        String
  categoria     String?
  costoMensual  Float    @default(0)
  responsable   String?
  proveedor     String?
  notas         String?
  estado        String   @default("activo")
  clientId      String?
  client        InventoryClient?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([clientId])
}

model InventoryThirdPartySupport {
  id            String   @id @default(cuid())
  nombre        String
  contacto      String?
  telefono      String?
  email         String?
  servicios     String?
  costoMensual  Float    @default(0)
  costoAnual    Float    @default(0)
  contrato      String?
  estado        String   @default("activo")
  clientId      String?
  client        InventoryClient?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([clientId])
}

model InventoryITProject {
  id            String   @id @default(cuid())
  nombre        String
  descripcion   String?
  estado        String   @default("en_progreso")
  responsable   String?
  presupuesto   Float    @default(0)
  avance        Int      @default(0)
  fechaInicio   DateTime?
  fechaFin      DateTime?
  notas         String?
  clientId      String?
  client        InventoryClient?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([estado])
  @@index([clientId])
}

// ============================================
// INVENTARIO TIC - WIZARD & REPORTES
// ============================================

model TicInventario {
  id            String   @id @default(cuid())
  userId        String
  clientId      String
  nombre        String   // ej: "Inventario 2024 - Reverse"
  descripcion   String?
  estado        String   @default("borrador") // "borrador", "completado", "archivado"
  fecha         DateTime?
  gastoAnual    Float    @default(0) // Total anual calculado
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  client        InventoryClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  categorias    TicCategory[]

  @@index([userId])
  @@index([clientId])
  @@index([estado])
}

model TicCategory {
  id            String   @id @default(cuid())
  inventarioId  String
  nombre        String   // ej: "Equipos", "Licencias", "Consumos"
  descripcion   String?
  orden         Int      @default(0)
  gastoTotal    Float    @default(0) // Calculado: suma de todos los artículos

  inventario    TicInventario @relation(fields: [inventarioId], references: [id], onDelete: Cascade)
  articulos     TicArticle[]

  @@index([inventarioId])
}

model TicArticle {
  id            String   @id @default(cuid())
  categoriaId   String
  nombre        String
  descripcion   String?
  cantidad      Float    @default(1)
  precioUnitario Float   @default(0)
  subtotal      Float    @default(0) // cantidad × precioUnitario
  fechaVencimiento DateTime?
  proveedor     String?
  responsable   String?
  notas         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  categoria     TicCategory @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@index([categoriaId])
}

// ============================================
// GESTIÓN DE TÉCNICOS, JORNADAS Y PAGOS
// ============================================

model TecnicoRol {
  id            String   @id @default(cuid())
  userId        String
  nombre        String
  descripcion   String?
  tarifaDiaria  Float    @default(0)
  color         String   @default("#3B82F6")
  createdAt     DateTime @default(now())

  tecnicos      Tecnico[]
  asignaciones  ProyectoAsignacion[]

  @@index([userId])
}

model Tecnico {
  id                String   @id @default(cuid())
  userId            String
  codigo            String?
  nombre            String
  cedula            String?
  telefono          String?
  email             String?
  direccion         String?
  foto              String?
  rolId             String?
  especialidades    String?  // JSON array
  tarifaDiaria      Float    @default(0)
  tarifaHora        Float?
  tarifaHoraExtra   Float    @default(0)
  fechaIngreso      DateTime?
  estado            String   @default("activo") // activo, inactivo, suspendido
  tipoContratacion  String   @default("fijo")   // fijo, temporal, subcontratista, ayudante, supervisor
  datosBancarios    String?  // JSON
  notas             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  rol               TecnicoRol?          @relation(fields: [rolId], references: [id])
  asignaciones      ProyectoAsignacion[]
  jornadas          Jornada[]
  anticipos         Anticipo[]
  recibos           Recibo[]

  @@index([userId])
  @@index([estado])
}

model ProyectoAsignacion {
  id              String   @id @default(cuid())
  tecnicoId       String
  projectId       String
  userId          String
  rolId           String?
  rolNombre       String?
  fechaInicio     DateTime?
  fechaFin        DateTime?
  diasProgramados Int      @default(0)
  tarifaDiaria    Float    @default(0)
  tarifaHoraExtra Float    @default(0)
  bonificacion    Float    @default(0)
  viaticos        Float    @default(0)
  transporte      Float    @default(0)
  alimentacion    Float    @default(0)
  descuento       Float    @default(0)
  anticipo        Float    @default(0)
  responsableAuth String?
  estado          String   @default("activo")
  notas           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tecnico         Tecnico            @relation(fields: [tecnicoId], references: [id], onDelete: Cascade)
  project         Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rol             TecnicoRol?        @relation(fields: [rolId], references: [id])
  jornadas        Jornada[]

  @@index([tecnicoId])
  @@index([projectId])
  @@index([userId])
}

model Jornada {
  id              String   @id @default(cuid())
  tecnicoId       String
  projectId       String
  asignacionId    String?
  userId          String
  fecha           DateTime
  fechaFin             DateTime?
  diasTrabajados       Int      @default(1)
  fechasIndividuales   String?  // JSON array of date strings e.g. ["2026-06-14","2026-06-16"]
  horaEntrada     String?
  horaSalida      String?
  horasTotales    Float    @default(0)
  horasExtra      Float    @default(0)
  tipoJornada     String   @default("completa") // completa, media, horas, nocturna, fin_semana, feriado
  tarifaDia       Float    @default(0)
  tarifaHoraExtra Float    @default(0)
  bonificacion    Float    @default(0)
  viaticos        Float    @default(0)
  transporte      Float    @default(0)
  alimentacion    Float    @default(0)
  descuento       Float    @default(0)
  totalJornada    Float    @default(0)
  actividades     String?
  observaciones   String?
  estado          String   @default("programado") // programado, presente, ausente, cancelado, pendiente, aprobado
  aprobadoPor     String?
  periodoPagoId   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tecnico         Tecnico             @relation(fields: [tecnicoId], references: [id], onDelete: Cascade)
  project         Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  asignacion      ProyectoAsignacion? @relation(fields: [asignacionId], references: [id])
  periodoPago     PeriodoPago?        @relation(fields: [periodoPagoId], references: [id])

  @@unique([tecnicoId, projectId, fecha])
  @@index([tecnicoId])
  @@index([projectId])
  @@index([userId])
  @@index([fecha])
  @@index([estado])
  @@index([periodoPagoId])
}

model PeriodoPago {
  id              String   @id @default(cuid())
  userId          String
  nombre          String
  tipo            String   @default("semanal") // diario, semanal, quincenal, mensual, proyecto, personalizado
  fechaInicio     DateTime
  fechaFin        DateTime
  totalBruto      Float    @default(0)
  totalDescuentos Float    @default(0)
  totalAnticipos  Float    @default(0)
  totalNeto       Float    @default(0)
  estado          String   @default("borrador") // borrador, revision, aprobado, parcial, pagado, anulado
  fechaPago       DateTime?
  metodoPago      String?
  referencia      String?
  aprobadoPor     String?
  notas           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  jornadas        Jornada[]
  detalles        DetallePago[]
  recibos         Recibo[]

  @@index([userId])
  @@index([estado])
}

model DetallePago {
  id              String   @id @default(cuid())
  periodoPagoId   String
  tecnicoId       String
  userId          String
  diasTrabajados  Int      @default(0)
  horasNormales   Float    @default(0)
  horasExtra      Float    @default(0)
  salarioBase     Float    @default(0)
  bonificaciones  Float    @default(0)
  viaticos        Float    @default(0)
  transporte      Float    @default(0)
  alimentacion    Float    @default(0)
  otrosIngresos   Float    @default(0)
  descuentos      Float    @default(0)
  anticipos       Float    @default(0)
  pagoBruto       Float    @default(0)
  pagoNeto        Float    @default(0)
  estado          String   @default("pendiente") // pendiente, aprobado, pagado
  metodoPago      String?
  referencia      String?
  notas           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  periodoPago     PeriodoPago @relation(fields: [periodoPagoId], references: [id], onDelete: Cascade)

  @@index([periodoPagoId])
  @@index([tecnicoId])
  @@index([userId])
}

model Anticipo {
  id              String   @id @default(cuid())
  tecnicoId       String
  userId          String
  projectId       String?
  fecha           DateTime @default(now())
  monto           Float
  motivo          String?
  metodoPago      String?
  referencia      String?
  autorizadoPor   String?
  periodoPagoId   String?  // periodo donde se aplicó
  estado          String   @default("pendiente") // pendiente, aplicado, cancelado
  notas           String?
  createdAt       DateTime @default(now())

  tecnico         Tecnico  @relation(fields: [tecnicoId], references: [id], onDelete: Cascade)

  @@index([tecnicoId])
  @@index([userId])
  @@index([estado])
}

model Recibo {
  id              String   @id @default(cuid())
  numero          String   @unique
  periodoPagoId   String?
  detallePagoId   String?
  tecnicoId       String
  userId          String
  fechaEmision    DateTime @default(now())
  contenido       String?  // JSON snapshot
  estado          String   @default("pendiente") // pendiente, firmado, rechazado, anulado
  firmadoEn       DateTime?
  notas           String?
  createdAt       DateTime @default(now())

  tecnico         Tecnico      @relation(fields: [tecnicoId], references: [id], onDelete: Cascade)
  periodoPago     PeriodoPago? @relation(fields: [periodoPagoId], references: [id])

  @@index([tecnicoId])
  @@index([userId])
  @@index([estado])
}

// ============================================
// ALERTAS Y AUTOMATIZACIÓN
// ============================================

model Alert {
  id            String   @id @default(cuid())
  userId        String
  tipo          String   // "licencia_vence", "equipo_mantenimiento", "pago_pendiente"
  titulo        String
  descripcion   String?
  severidad     String   @default("info") // "info", "warning", "critical"
  leido         Boolean  @default(false)
  referenceId   String?  // ID de la licencia, equipo, proyecto, etc.
  referenceType String?  // "license", "equipment", "project"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([leido])
  @@index([severidad])
}

model AutomationSchedule {
  id            String   @id @default(cuid())
  userId        String
  nombre        String
  tipo          String   // "reporte_email", "notificacion_vencimiento"
  activo        Boolean  @default(true)
  frecuencia    String   @default("weekly") // "daily", "weekly", "monthly"
  proximaEjecucion DateTime?
  ultimaEjecucion DateTime?
  configuracion String?  // JSON con parámetros
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([activo])
}

model AlertLog {
  id            String   @id @default(cuid())
  userId        String
  tipo          String
  referenceId   String?
  estado        String   // "enviado", "fallido", "pendiente"
  mensaje       String?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([estado])
  @@index([createdAt])
}
